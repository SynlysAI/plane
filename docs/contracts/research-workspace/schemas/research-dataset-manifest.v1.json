{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plane.synlys.ai/contracts/research-workspace/research-dataset-manifest.v1.json",
  "title": "Research Dataset Manifest v1",
  "description": "An immutable list of content-addressed research data objects referenced by Git.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "research-dataset-manifest.v1"
    },
    "study_id": {
      "type": "string",
      "format": "uuid"
    },
    "dataset_id": {
      "type": "string",
      "format": "uuid"
    },
    "logical_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "data_dictionary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "asset_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?:[A-Za-z0-9._()+,-]+(?:/[A-Za-z0-9._()+,-]+)*)$",
            "not": {
              "pattern": "(^|/)\\.\\.?(/|$)"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255
          },
          "source_system": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "source_run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["asset_revision_id", "path", "sha256", "size", "media_type", "source_system"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "study_id", "dataset_id", "logical_name", "revision", "data_dictionary", "items"],
  "additionalProperties": false
}
