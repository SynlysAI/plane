{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4ms.local/contracts/research-intelligent-platform/agent-plugin.v1.json",
  "title": "Agent plugin manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "plugin_id",
    "manifest_version",
    "entrypoints",
    "required_scopes",
    "capabilities",
    "ui",
    "feature_flag"
  ],
  "properties": {
    "schema_version": { "const": "agent-plugin.v1" },
    "plugin_id": { "const": "research-agent" },
    "manifest_version": { "const": "agent-plugin.v1" },
    "entrypoints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "required_scopes": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "ui": {
      "type": "object",
      "additionalProperties": true,
      "required": ["desktop", "mobile"],
      "properties": { "desktop": { "type": "string" }, "mobile": { "type": "string" } }
    },
    "feature_flag": { "const": "research_agent_enabled" },
    "ui_states": { "type": "array", "items": { "type": "string" } },
    "transport": {
      "type": "object",
      "additionalProperties": true,
      "required": ["events", "iframe"],
      "properties": {
        "events": { "type": "string" },
        "streaming": { "type": "string" },
        "iframe": { "const": "forbidden" }
      }
    }
  }
}
