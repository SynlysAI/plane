{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4ms.local/contracts/research-intelligent-platform/integration-result.v1.json",
  "title": "Integration result v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "source_system", "request_id", "items", "degraded", "synced_at"],
  "properties": {
    "schema_version": { "const": "integration-result.v1" },
    "source_system": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "items": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "degraded": { "type": "boolean" },
    "degraded_reason": { "type": ["string", "null"] },
    "synced_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
