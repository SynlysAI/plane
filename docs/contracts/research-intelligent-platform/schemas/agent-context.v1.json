{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4ms.local/contracts/research-intelligent-platform/agent-context.v1.json",
  "title": "Agent context v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "context_id", "scope", "resources", "generated_at", "context_hash"],
  "properties": {
    "schema_version": { "const": "agent-context.v1" },
    "context_id": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "required": ["workspace_id", "visibility_scope"],
      "properties": {
        "workspace_id": { "type": "string" },
        "research_project_id": { "type": ["string", "null"] },
        "chain_node_id": { "type": ["string", "null"] },
        "visibility_scope": { "type": "string" }
      }
    },
    "resources": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "generated_at": { "type": "string", "format": "date-time" },
    "context_hash": { "type": "string", "minLength": 1 },
    "expires_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
