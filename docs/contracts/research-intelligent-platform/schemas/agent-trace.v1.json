{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4ms.local/contracts/research-intelligent-platform/agent-trace.v1.json",
  "title": "Agent trace v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "session_id", "events", "tool_calls", "decisions"],
  "properties": {
    "schema_version": { "const": "agent-trace.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": ["string", "null"] },
    "events": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "tool_calls": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "decisions": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
