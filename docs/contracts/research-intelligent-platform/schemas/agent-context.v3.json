{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4ms.local/contracts/research-intelligent-platform/agent-context.v3.json",
  "title": "Agent context v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_id", "context_hash", "expires_at", "target", "subject", "policy"],
  "properties": {
    "schema_version": {
      "const": "agent-context.v3"
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "context_hash": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "workspace_id", "workspace_slug"],
      "properties": {
        "type": {
          "enum": ["WORKSPACE", "PROJECT", "RESEARCH_CHAIN", "RESEARCH_CHAIN_NODE"]
        },
        "workspace_id": {
          "type": "string"
        },
        "workspace_slug": {
          "type": "string"
        },
        "project_id": {
          "type": ["string", "null"]
        },
        "research_chain_id": {
          "type": ["string", "null"]
        },
        "chain_node_id": {
          "type": ["string", "null"]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plane_user_id", "delegated_subject", "scope_kind", "scope_source"],
      "properties": {
        "plane_user_id": {
          "type": "string"
        },
        "delegated_subject": {
          "type": "string"
        },
        "scope_kind": {
          "enum": ["OWNER", "REVIEW"]
        },
        "scope_source": {
          "type": "string"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_hash",
        "policy_version",
        "visibility_scope",
        "allowed_tools",
        "allowed_plugins",
        "allowed_mcp_ids",
        "allowed_knowledge_base_ids",
        "allowed_file_ids"
      ],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "policy_hash": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "visibility_scope": {
          "type": "string"
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_plugins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_mcp_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_knowledge_base_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_file_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "hash", "summary", "resources"],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "maxLength": 12000
        },
        "resources": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
