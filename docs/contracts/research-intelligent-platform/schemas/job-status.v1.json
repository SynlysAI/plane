{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4ms.local/contracts/research-intelligent-platform/job-status.v1.json",
  "title": "Job status v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "job_id", "run_id", "status", "attempt"],
  "properties": {
    "schema_version": { "const": "job-status.v1" },
    "job_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "DEGRADED"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "error_code": { "type": ["string", "null"] }
  }
}
