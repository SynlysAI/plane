{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4ms.local/contracts/research-intelligent-platform/taxonomy.v1.json",
  "title": "Research Intelligent Platform taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_types",
    "node_statuses",
    "event_types",
    "snapshot_types",
    "todo_sources",
    "todo_statuses",
    "degraded_modes"
  ],
  "properties": {
    "schema_version": { "const": "taxonomy.v1" },
    "node_types": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "node_statuses": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "event_types": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "snapshot_types": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "todo_sources": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "todo_statuses": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "degraded_modes": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
  }
}
