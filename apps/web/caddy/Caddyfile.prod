{
	servers {
		trusted_proxies static private_ranges
	}
}

:3300 {
	root * /usr/share/caddy/html

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# 保留浏览器 Host 与端口，供 Django 校验来源并生成同源上传地址。
	handle /api/* {
		reverse_proxy api:8000 {
			header_up Host {http.request.hostport}
		}
	}
	handle /auth/* {
		reverse_proxy api:8000 {
			header_up Host {http.request.hostport}
		}
	}

	# MinIO 下载签名包含完整 Host，存储代理也必须保留端口。
	handle /uploads/* {
		reverse_proxy plane-minio:9000 {
			header_up Host {http.request.hostport}
		}
	}

	redir /god-mode /god-mode/ 308
	handle_path /god-mode/* {
		root * /usr/share/caddy/admin
		try_files {path} /index.html
		file_server
	}

	# index.html must always be revalidated: it references hashed assets, so a
	# cached copy pins users to stale bundles after a deploy. Hashed assets
	# under /assets/ are immutable and cache freely.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}

	log {
		output stdout
		format console
	}
}
