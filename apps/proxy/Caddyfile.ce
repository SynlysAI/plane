(global_request_body) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}
}

(research_request_body) {
	request_body {
		max_size {$RESEARCH_CHAIN_UPLOAD_MAX_BYTES}
	}
}

(plane_proxy) {
	handle /api/research/workspaces/*/chains/*/uploads {
		import research_request_body
		reverse_proxy api:8000
	}

	handle /api/research/workspaces/*/chains/*/uploads/* {
		import research_request_body
		reverse_proxy api:8000
	}

	handle /api/* {
		import global_request_body
		reverse_proxy api:8000
	}

	handle /auth/* {
		import global_request_body
		reverse_proxy api:8000
	}

	handle /spaces {
		redir /spaces/ permanent
	}

	handle /spaces/* {
		import global_request_body
		reverse_proxy space:3000
	}

	handle /god-mode {
		redir /god-mode/ permanent
	}

	handle /god-mode/* {
		reverse_proxy admin:3000
	}

	handle /live/* {
		import global_request_body
		reverse_proxy live:3000
	}

	handle /static/* {
		reverse_proxy api:8000
	}

	handle /{$BUCKET_NAME}/* {
		reverse_proxy plane-minio:9000
	}

	handle /{$BUCKET_NAME} {
		reverse_proxy plane-minio:9000
	}

	handle * {
		import global_request_body
		reverse_proxy web:3000
	}
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}
